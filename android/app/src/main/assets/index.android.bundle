xport",exportQaDocumentsNoDocuments:"No documents to export.",exportQaDocumentsNoneSelected:"Select at least one document.",exportQaDocumentsSelectTitle:"Select documents",exportQaDocumentsExportSelected:"Export selected",exportShareNow:"Share",exportChooseTitle:"Diagnostic export",exportChooseDocumentsTitle:"Diagnostic export",exportAllOption:"All ({{count}})",exportBatchSection:"Batches of 30 (list order)",exportBatchOption:"Cards {{from}}\u2013{{to}} ({{count}})",exportBatchDocumentsOption:"Documents {{from}}\u2013{{to}} ({{count}})",exportSelectOption:"Select from list",exportDoneTitle:"Diagnostic export ready",exportDoneMessage:"File ready: {{fileName}}\n{{count}} contacts \xb7 ~{{size}} MB\n\nTap \xabShare\xbb to save to Drive, Downloads, or email.\nKeep the screen on during export.",exportDoneMessageDocuments:"File ready: {{fileName}}\n{{count}} documents \xb7 ~{{size}} MB\n\nTap \xabShare\xbb to save to Drive, Downloads, or email.\nKeep the screen on during export.",exportShareAgain:"Share",exportKeepScreenOn:"Do not turn off the screen or switch apps before processing finishes.",exportProgressCounter:"Exported {{current}} of {{total}} cards",exportProgressDocumentsCounter:"Exported {{current}} of {{total}} documents",exportProgressImages:"Reading images {{current}}/{{total}}...",exportProgressZip:"Creating ZIP...",exportReadyBanner:"Diagnostic export ready ({{count}} contacts) \u2014 tap to share",exportReadyBannerDocuments:"Diagnostic export ready ({{count}} documents) \u2014 tap to share",exportClose:"Close",diagnosticExportTitle:"Diagnostic export",diagnosticExportWarning:"The diagnostic package may contain personal data, OCR text, images, and technical information useful for support. Share it only if needed and only with trusted recipients.",diagnosticExportContinue:"Continue",exportShareUnavailable:"Sharing not available on this device.",exportQaPreparing:"Preparing export...",exportQaPreparingCount:"Preparing export...\n{{count}} contacts",exportQaNoContacts:"No contacts to export.",exportQaNoneSelected:"Select at least one contact.",exportQaError:"Could not prepare export. Try fewer contacts.",exportQaSelectTitle:"Select contacts",exportQaSelectAll:"All",exportQaSelectedCount:"{{count}} of {{total}} selected",exportQaExportSelected:"Export selected",exportSortLabel:"Sort contacts",exportSortNewest:"Date: newest first",exportSortOldest:"Date: oldest first",exportSortNameAsc:"Name: A\u2013Z",exportSortNameDesc:"Name: Z\u2013A",reparseAllTitle:"Re-parse all contacts",reparseAllConfirmTitle:"Re-parse contacts?",reparseAllConfirmMessage:"The updated parser will re-read saved OCR for {{count}} contacts. Notes and photos are kept. This may take a few minutes.",reparseAllRunning:"Re-parsing {{current}}/{{total}}...",reparseProgressCounter:"Re-parsed {{current}} of {{total}} cards",reparseAllPreviewTitle:"Re-parse preview",reparseAllPreviewMessage:"Proposal ready: {{changed}} contacts would change, {{unchanged}} would stay unchanged, {{skipped}} would be skipped, and {{errors}} have errors. No data has been saved.",reparseAllApply:"Apply proposal",reparseDoneTitle:"Re-parse complete",reparseAllDone:"Re-parsed {{updated}} contacts ({{changed}} changed, {{unchanged}} unchanged, {{skipped}} skipped, {{errors}} errors).\nParser: {{parserBuildId}}",reparseAllError:"Error while re-parsing contacts.",clearAllContactsTitle:"Clear all contacts",clearAllContactsMessage:"This will delete {{count}} contacts from the local database. Gallery photos are not affected. This cannot be undone.",clearAllContactsConfirm:"Delete all",clearAllContactsEmpty:"No contacts to delete.",clearAllContactsDoneTitle:"Contacts database cleared",clearAllContactsDone:"Removed {{count}} contacts.",clearAllContactsError:"Could not clear the database.",reparseContactTitle:"Re-parse from OCR",reparseContactConfirmTitle:"Re-parse this contact?",reparseContactConfirmMessage:"The updated parser will re-read saved OCR text. Notes are kept. Then tap Save to confir