ation.",aiHelpQuotaExceeded:"Daily AI request limit reached. Please try again tomorrow.",aiHelpError:"Could not reach the AI. Check your connection and try again.",confidenceHigh:"HIGH",confidenceMedium:"MEDIUM",confidenceLow:"LOW",correctWithAiButton:"AI support",improveWithAiButton:"AI support",extractionReviewBannerTitle:"Fields to review",extractionReviewBannerBody:"{{count}} fields may need manual review.",sendData:"Send data",deleteConfirmTitle:"Delete document?",deleteConfirmMessage:"This cannot be undone.",internalNotesHint:"Internal notes (not sent by email unless on Send screen).",home:"Home",contacts:"Contacts",documents:"Documents",scan:"Scan",save:"Save",export:"Export",success:"Success",title:"Title",company:"Company",email:"Email",phone:"Phone",role:"Role",website:"Website",address:"Address",vatNumber:"VAT number",taxCode:"Tax code",notes:"Notes",delete:"Delete",noContacts:"No saved contacts",contactsSearchPlaceholder:"Search contacts\u2026",contactsSearchClear:"Clear search",contactsSearchMinChars:"Type at least {{min}} letters to filter",contactsSearchResults:"{{count}} results",contactsSearchNoResults:"No contacts found",contactsSortLabel:"Sort:",contactsSortDate:"Date",contactsSortAlpha:"A\u2013Z",contactsSortName:"Name",sortDateAscendingHint:"Sort contacts from oldest to newest",sortDateDescendingHint:"Sort contacts from newest to oldest",sortNameAscendingHint:"Sort contacts by name from A to Z",sortNameDescendingHint:"Sort contacts by name from Z to A",noDocuments:"No saved documents",documentsSearchPlaceholder:"Search title, text\u2026",documentsSearchClear:"Clear search",documentsSearchMinChars:"Type at least {{min}} letters to filter",documentsSearchResults:"{{count}} results",documentsSearchNoResults:"No documents found",documentsFilterAll:"All",documentsFilterQuote:"Quotes",documentsFilterOrder:"Orders",documentsFilterInvoice:"Invoices",documentsFilterFreeDocument:"Docs",selectionCountOne:"1 selected",selectionCountMany:"{{count}} selected"