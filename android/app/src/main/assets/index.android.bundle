s",emailNotesHint:"Context for the recipient: owner, trade fair lead, products discussed\u2026",emailNotesPlaceholder:"E.g. Owner, Representative, New lead, New customer\u2026",documentNotesLabel:"Notes",documentNotesHint:"Free text for this document (visible on the document screen and in export).",documentNotesPlaceholder:"E.g. urgency, follow-up, details to remember\u2026",ocrProcessing:"Please wait, reading document\u2026","processing.title":"Processing document","processing.cardTitle":"Processing business card","processing.cardPrepare":"Preparing business card...","processing.cardAnalyze":"Analyzing contact...","processing.cardPersist":"Saving contact...","processing.prepare":"Preparing document...","processing.ocr":"Recognizing text...","processing.ocrPage":"Recognizing text \u2014 page {{current}} of {{total}}","processing.pageResults":"Organizing text...","processing.layout":"Analyzing document structure...","processing.metadata":"Identifying key data...","processing.itemsTotals":"Analyzing lines and totals...","processing.reconcile":"Verifying results...","processing.fallback":"Completing with data to review...","processing.persist":"Saving","processing.pdfPrepare":"Preparing PDF","processing.pdfRead":"Reading PDF","processing.pdfPayload":"Preparing data","processing.pdfUpload":"Sending to AI service","processing.pdfExtract":"Processing with AI","processing.pdfVerify":"Verifying data","processing.done":"Completed","processing.slow":"Finishing the analysis...","processing.partialNotice":"Analysis partially completed. Review the data before saving.","processing.badImage":"Image is hard to read. Scan again.","processing.rescan":"Scan again",duplicateTitle:"Duplicate document?",duplicateMessage:"There seems to be a duplicate of \"{{title}}\". Delete the most recent copy?",keepBoth:"Keep both",deleteDuplicate:"Delete copy",documentAlreadyExistsTitle:"Document already exists",documentAlreadyExistsMessage_order:"An order with number {{number}} already exists.",documentAlreadyExistsMessage_quote:"A quote with number {{number}} already exists.",documentAlreadyExistsMessage_invoice:"An invoice with number {{number}} already exists.",documentAlreadyExistsMessage_free_document:"A document with number {{number}} already exists.",documentAlreadyExistsQuestion:"Open the existing document or save a new copy anyway?",possibleDuplicateTitle:"Possible duplicate",possibleDuplicateMessage:"A similar document is already saved. Check it before creating another copy.",openExistingDocument:"Open existing",viewExistingDocument:"View existing",contactDuplicateTitle:"Contact already exists?",contactDuplicateMessage:"A contact for \"{{name}}\" already seems to exist. Save anyway?",saveAnyway:"Save anyway",contactDuplicateResolutionMessage:"Possible duplicate: \"{{name}}\"\nLevel: {{level}}\nReason: {{reason}}\n\nMatching fields: {{equalFields}}\nDifferent fields: {{differentFields}}\n\nThe existing contact stays unchanged until you choose.",contactDuplicateUpdateExisting:"Update existing contact",contactDuplicateSaveNew:"Save as new",contactDuplicateTierExact:"exact",contactDuplicateTierProbable:"probable",contactDuplicateTierPossible:"possible",contactDuplicateReasonEmail:"same email",contactDuplicateReasonPhone:"same phone or WhatsApp",contactDuplicateReasonIdentity:"compatible identity and company data",contactDuplicateReasonName:"compatible name and card content",contactDuplicateNoFields:"none",contactDuplicateFieldName:"Name",contactDuplicateFieldCity:"City",contactDuplicateFieldCountry:"Country",contactDuplicateFieldImages:"Images",contactDuplicateFieldOcr:"OCR text",contactDuplicateFieldReviewTitle:"Choose fields to update",contactDuplicateFieldReviewIntro:"Review every field before updating. Manually edited fields are protected and cannot be selected.",contactDuplicateFieldStatusProtected:"protected (manual edit)",contactDuplicateFieldStatusUnchanged:"unchanged",contactDuplicateFieldStatusSelectable:"choose",contactDuplicateCurrentValue:"Current value",contactDuplicateProposedValue:"Proposed value",contactDuplicateChooseFields:"Choose field by field",contactDuplicateBackToDraft:"Back to contact",contactDuplicateFieldChoiceTitle:"Update {{field}}?",contactDuplicateFieldChoiceMessage:"Current value:\n{{current}}\n\nProposed value:\n{{proposed}}",contactDuplicateKeepExisting:"Keep current",contactDuplicateUseProposed:"Use proposed",contactDuplicateStaleTitle:"Contact changed",contactDuplicateStaleMessage:"The existing contact changed during review. Nothing was updated. Save again to compare the latest version.",handwritingOcrHint:"Handwriting and graph paper greatly limit automatic reading. Check and correct fields manually; below is the text the app managed to read.",ocrReadText:"Text read from document",documentLocalReviewHint:"You can explicitly send the document images to an AI service to try to improve the extracted data. The proposed result will not be saved until you tap Save.",documentAiButton:"AI support",documentAiCreditsRemaining:"Remaining AI credits: {{count}}",documentAiCreditsExhausted:"AI credits exhausted",documentAiSuccess:"Data updated on this screen. Review it and press Save to store it.",documentAiError:"The AI service could not complete the processing. The local document was not changed.",documentAiNotConfigured:"The AI service is not configured. The local document was not changed.",imageViewerHint:"Pinch to zoom \xb7 double tap \xb7 drag \xb7 swipe down to close",rotateImage:"Rotate",rotateDocument180:"Rotate 180\xb0",imageLoadError:"Unable to load image",importPdf:"Import PDF",pdfImportAiDeferred:"PDF import reads the file with cloud AI, which is switched off in this release candidate. It comes back once AI credit metering is verified.",importPdfShort:"PDF",pdfErrorTitle:"PDF error",pdfErrorNotReadable:"The selected PDF cannot be read on this device.",pdfErrorTooLarge:"The PDF is too large to process.",pdfErrorInvalid:"The selected file is not a valid PDF.",pdfErrorPageLimit:"The PDF has too many pages to process.",pdfErrorUploadFailed:"The PDF was read, but sending it to the service failed.",licenseExpiredTitle:"Trial period ended",licenseActivateTitle:"Activate license",licenseActivateBody:"Enter the email and key you received. You can also keep using the free trial ({{days}} days).",licenseAlreadyHave:"I already have a license",licenseBackToTrial:"\u2190 Back to free trial",licenseExpiredBody:"Your {{days}}-day free trial has ended (expired {{date}}). Enter your email and license key to continue.",licenseExpiredReadOnlyBody:"Your {{days}}-day free trial has ended (expired {{date}}). You can still view and export saved data. New scans, PDF import, and AI require a license.",licenseContinueToData:"Continue to my data",licenseExpiredNewScanBlocked:"Your trial has ended. Activate a license to capture new business cards.",licenseExpiredNewDocumentBlocked:"Your trial has ended. Activate a license to capture new documents.",licenseExpiredPdfBlocked:"Your trial has ended. Activate a license to import PDFs.",licenseExpiredBanner:"Trial ended \u2014 view and export saved data only",licenseEmailLabel:"Email",licenseEmailPlaceholder:"name@company.com",licenseEmailHint:"\u2022 The key is tied to your email (max 2 phones per premium license)",licenseKeyLabel:"License key",licenseKeyPlaceholder:"BS-PREM-XXXX-XXXX",licenseActivate:"Activate license",licenseContactHint:"Contact your provider to purchase an annual license.",licenseTypesTitle:"License types",licenseTypeTest:"\u2022 Test (BS-TEST-\u2026): {{days}} days, for demos and evaluation",licenseTypePremium:"\u2022 Premium (BS-PREM-\u2026): {{days}} days, full access",licenseErrorEmpty:"Enter your license key.",licenseErrorInvalid:"Invalid or unrecognized key.",licenseErrorExpired:"License expired.",licenseErrorOffline:"Internet connection required to activate license.",licenseTrialBanner:"Trial \xb7 {{days}} days left",licenseTrialBannerScans:"{{used}} / {{max}} scans used",licenseTrialBannerScansRemaining:"{{remaining}} scans remaining",licenseTrialAiCredits:"AI: {{credits}} credits available",licenseTrialAiUnavailable:"AI enhancement unavailable. You can keep using local scan.",licenseTrialExpiredScans:"You reached the trial scan limit.",licenseTrialExpiredTime:"Your trial period has ended.",licenseTestBanner:"Test license: {{days}} days left (expires {{date}})",licensePremiumBanner:"Premium license active until {{date}}",licenseErrorEmailRequired:"Enter your email.",licenseErrorEmailInvalid:"Invalid email address.",licenseErrorEmailMismatch:"Email or key does not match this license.",licenseErrorMaxDevices:"Maximum devices reached for this email.",licenseErrorRevoked:"License revoked. Contact your provider.",licenseOfflineTitle:"Connection required",licenseOfflineBody:"The app checks your license online at startup. Enable Wi\u2011Fi or mobile data and try again.",licenseRetry:"Retry",privacyTitle:"Privacy and data processing",privacySubtitle:"Before using Business Scanner, please read how personal data is processed.\n\nThis screen contains a summary of the main privacy information. The complete Privacy Policy, containing all details required by Regulation (EU) 2016/679 (GDPR) and applicable laws, is always available on the official Business Scanner website.",privacyHeader1:"License Data",privacySection1:"To manage activation, trial period, licensing and support, KFIVE processes certain technical and identifying data, such as email, installation or device identifier, active plan, license status and available AI quota.",privacyHeader2:"Data Collected by the App",privacySection2:"Photos of business cards and documents, OCR extracted data, contacts, notes, and imported PDFs are normally stored exclusively on the device.\n\nDuring normal local use, KFIVE cannot access this content.",privacyHeader3:"Optional AI Assistance",privacySection3:"When local recognition is insufficient, you can choose to use the \"Ask AI for Help\" feature.\n\nOnly in this case, the selected document, image, or text is transmitted online to a cloud artificial intelligence service to perform the requested processing.\n\nKFIVE does not use this content for advertising, marketing or profiling and does not intentionally store it in its databases.\n\nA specific warning will be shown before every transmission to the AI.",privacyHeader4:"User Responsibility",privacySection4:"You must be authorized to acquire and use the data contained in business cards and documents.\n\nOCR and Artificial Intelligence may produce inaccurate results.\nAlways verify the data before saving, exporting, sharing, or using it.",privacyOpenFullPolicy:"Click here to read the full Privacy Policy",privacyPolicyUrlError:"Could not open the link.",privacyConsentSaveError:"Could not save your privacy confirmation. Please try again.",privacyConsentHint:"By selecting \"I have read and understood\", you confirm that you have reviewed this summary and have been informed of the availability of the complete Privacy Policy published on the official Business Scanner website.\n\nThis confirmation does not constitute a general consent to optional processing, which will be requested separately with specific notices when required.",privacyAccept:"I have read and understood",privacyDecline:"Exit",privacyDeclineTitle:"Review Required",privacyDeclineMessage:"Without reviewing the privacy policy you cannot use Business Scanner. You can exit the app or accept to continue.",privacyDeclineExit:"Exit app",geminiModalTitleExtended:"Online AI Processing",geminiModalTitleShort:"Send with AI support",geminiModalIntro:"You are about to send the selected document, image, or text to the AI support service.\n\nTransmission is required solely to perform data checking, completion, or extraction.",geminiModalIntroImages:"You are about to send the selected document images to the AI support service (pages: {{count}}).\n\nThey will be sent only after your confirmation and solely to try to improve data extraction.",geminiModalIntroPdf:"The PDF you select will be sent to the AI support service to extract its data.\n\nThe file picker and upload will start only after your confirmation.",geminiModalWarningTitle:"Before continuing",geminiModalWarningText:"Verify that you are authorized to transmit the data in the document.\n\nDo not send:\n\u2022 passwords or credentials;\n\u2022 complete payment card details;\n\u2022 health data;\n\u2022 highly sensitive data;\n\u2022 trade secrets;\n\u2022 highly confidential documents;\n\u2022 information unnecessary for processing.",geminiModalPrivacyNotice:"KFIVE does not ordinarily inspect submitted content, does not use it for advertising or profiling, and does not intentionally store it in its databases.\n\nThe AI support provider processes data under the terms applicable to the service.\n\nThe result may contain errors and must be verified before saving, using, or sharing.",geminiModalCreditConsume:"This operation will consume {{credits}} AI credit(s).",geminiModalCreditRemaining:"Remaining credits after operation: {{remaining}}",geminiModalDontShowAgain:"Don't show extended notice again",geminiModalShortBody:"Send text to the AI support service for data completion.\n\nCost: {{credits}} AI credit.\nRemaining credits after operation: {{remaining}}.",geminiModalShortBodyImages:"Send the document images to the AI support service (pages: {{count}}) to improve data extraction.\n\nCost: {{credits}} AI credit.\nRemaining credits after operation: {{remaining}}.",geminiModalShortBodyPdf:"The PDF you select will be sent to the AI support service to extract its data.\n\nCost: {{credits}} AI credit.\nRemaining credits after operation: {{remaining}}.",geminiModalShortBodyImagesNoCredits:"Send the document images to the AI support service (pages: {{count}}) to improve data extraction.",geminiModalShortBodyPdfNoCredits:"The PDF you select will be sent to the AI support service to extract its data.",geminiModalSendButton:"AI support",geminiModalSelectPdfButto