# 2) Edge Functions → Secrets (solo server):
#    - GEMINI_API_KEY (Gemini API auth key; non una Standard API key legacy)
#    - GEMINI_MODEL=gemini-3.5-flash-lite
#    - EDGE_ALLOWED_ORIGINS=https://scanner.example.com
#      (opzionale; lista separata da virgole per il solo client web. L'app
#      nativa non invia Origin; CORS non è autenticazione.)
#    - EDGE_RATE_LIMIT_MAX_REQUESTS=10
#    - EDGE_RATE_LIMIT_WINDOW_MS=60000
#    - EDGE_MAX_CONCURRENT_REQUESTS=3
#    - EDGE_LEASE_TTL_SECONDS=55
#    - EDGE_RATE_LIMIT_SALT=
#      (secret casuale server-side di almeno 32 caratteri; non riutilizzare
#      chiavi API e non esporlo nel client)
